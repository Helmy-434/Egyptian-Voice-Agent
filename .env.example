LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
AGENT_BACKEND=graph

# ---- STT ----
STT_PROVIDER=cloud
STT_CLOUD_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.5-transcribe
STT_CLOUD_TIMEOUT_SEC=15

# For local QwenCleo, switch STT_PROVIDER to qwencleo.
# QWENCLEO_MODEL_PATH=QwenCleo/models/qwencleo-asr-q8_0.gguf
# QWENCLEO_SERVER_PATH=QwenCleo/runtime/audiocpp_server.exe
# QWENCLEO_ALLOW_CPU=false

# ---- TTS ----
# Cloud TTS (default for CPU/Docker deployment)
TTS_PROVIDER=cloud
TTS_CLOUD_PROVIDER=edge
# Edge TTS voices (free, no API key needed)
EDGE_MALE_VOICE=ar-EG-ShakirNeural
EDGE_FEMALE_VOICE=ar-EG-SalmaNeural
# Azure TTS (higher quality, requires API key)
# TTS_CLOUD_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_MALE_VOICE=ar-EG-ShakirNeural
# AZURE_FEMALE_VOICE=ar-EG-SalmaNeural


# EMAIL CONFIGURATION (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
SUPPORT_EMAIL_ALLOWLIST=customer1@gmail.com,customer2@gmail.com

# ==========================================
# TELEGRAM CONFIGURATION
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Internal support group or chat ID
SUPPORT_TELEGRAM_CHAT_ID=your_support_chat_id

# TOOL SECURITY
# true = simulate external actions
# false = perform real external actions
DRY_RUN=true

# Maximum customer-directed emails per session
MAX_USER_SENDS_PER_SESSION=3

# Local VoiceTut GGUF via the bundled audio.cpp server
# TTS_PROVIDER=voicetut
# VOICETUT_MODEL_PATH=QwenCleo/models/voicetut-tts-q8_0.gguf
# VOICETUT_SERVER_PATH=QwenCleo/runtime/audiocpp_server.exe
# VOICETUT_SERVER_PORT=18762
# VOICETUT_VOICE_DIR=QwenCleo/voices/reference_speakers
VOICETUT_MALE_VOICE=mohammed
VOICETUT_FEMALE_VOICE=yasmin
VOICETUT_ALLOW_CPU=false
VOICETUT_SERVER_STARTUP_TIMEOUT_SEC=120
TTS_FIRST_CHUNK_TIMEOUT_SEC=3.0
TTS_TOTAL_TIMEOUT_SEC=10.0

# ---- VAD ----
# "silero" = Silero neural VAD (requires torch, numpy, silero-vad from requirements-gpu.txt)
# "energy" = Lightweight energy-based VAD (pure Python, no GPU needed)
VAD_PROVIDER=energy
# VAD_PREROLL_MS=300
# VAD_HYSTERESIS=0.15
# MAX_UTTERANCE_SEC=20.0
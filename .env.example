# --- Runtime Mode & Providers ---
AGENT_BACKEND=stub                  # stub | graph
STT_PROVIDER=qwencleo               # qwencleo | cloud
STT_CLOUD_PROVIDER=groq             # groq | azure
TTS_PROVIDER=voicetut               # voicetut | cloud
TTS_CLOUD_PROVIDER=edge             # azure | edge

# --- Voice Selection & Provider Speaker Mapping ---
DEFAULT_VOICE=female                # male | female
VOICETUT_MALE_VOICE=male_1
VOICETUT_FEMALE_VOICE=female_1
AZURE_MALE_VOICE=ar-EG-ShakirNeural
AZURE_FEMALE_VOICE=ar-EG-SalmaNeural
EDGE_MALE_VOICE=ar-EG-ShakirNeural
EDGE_FEMALE_VOICE=ar-EG-SalmaNeural

# --- Audio Transport & Session Limits ---
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=32
MAX_SESSION_DURATION_SEC=600

# --- LLM Configuration ---
LLM_PROVIDER=groq                   # groq | openai
LLM_BASE_URL=                       # Optional; auto-derived from LLM_PROVIDER if empty
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_OUTPUT_TOKENS=180
LLM_TIMEOUT_SEC=8.0

# --- Secrets ---
GROQ_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Email (SMTP) & Telegram ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL_ALLOWLIST=support@example.com

TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=

# --- VAD, Barge-In, & Idle Timer ---
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_DURATION_MS=450
BARGE_IN_MIN_SPEECH_MS=300
STT_MIN_CONFIDENCE=0.45
ENABLE_IDLE_OFFER=false
IDLE_TIMEOUT_SEC=15.0

# --- Chunker Tuning ---
CHUNK_FIRST_MIN_CHARS=25
CHUNK_NEXT_MIN_CHARS=60
CHUNK_MAX_CHARS=200

# --- Guardrails & Logging ---
DRY_RUN=true
MAX_USER_SENDS_PER_SESSION=3
AUDIT_LOG_PATH=logs/audit.jsonl
LATENCY_LOG_PATH=logs/latency.jsonl